// Writes supabase/seed.sql from the catalogue in src/data, so the database starts with the same coffees as the demo.
// Run with: npm run db:seed-file
import { writeFileSync } from "node:fs";
import { products } from "../src/data/products.ts";
import { discountCodes, reviews } from "../src/data/reviews.ts";

const q = (v: string) => `'${v.replace(/'/g, "''")}'`;
const arr = (v: string[]) => `array[${v.map(q).join(", ")}]::text[]`;

const rows = products.map((p) =>
  `  (${[
    q(p.id), q(p.slug), q(p.name), q(p.origin), q(p.region), q(p.process), q(p.roast), p.roastLevel, q(p.altitude), q(p.varietal),
    arr(p.notes), arr(p.flavour), arr(p.bestFor), q(p.tagline), q(p.description), p.price250, p.price1kg, p.stock,
    p.featured, p.isNew, p.decaf, `${q(JSON.stringify(p.art))}::jsonb`, p.active,
  ].join(", ")})`,
);

const header = "-- Generated by scripts/make-seed.mts. Edit src/data and run npm run db:seed-file instead of editing this file.";

// The starting catalogue and discount codes: safe to run more than once
const seed = `${header}

insert into public.products (id, slug, name, origin, region, process, roast, roast_level, altitude, varietal, notes, flavour, best_for, tagline, description, price_250, price_1kg, stock, featured, is_new, decaf, art, active) values
${rows.join(",\n")}
on conflict (id) do nothing;

insert into public.discount_codes (code, kind, value, min_subtotal, active, description) values
${discountCodes.map((c) => `  (${q(c.code)}, ${q(c.kind)}, ${c.value}, ${c.minSubtotal}, ${c.active}, ${q(c.description)})`).join(",\n")}
on conflict (code) do nothing;
`;

// Sample reviews, for a demo store only: a real shop starts with none
const sampleReviews = `${header}
-- Sample reviews for a demo store. Don't load these into a real shop.

insert into public.reviews (product_id, author_name, rating, body, created_at) values
${reviews.map((r) => `  (${q(r.productId)}, ${q(r.author)}, ${r.rating}, ${q(r.body)}, ${q(r.createdAt)})`).join(",\n")};
`;

writeFileSync(new URL("../supabase/seed.sql", import.meta.url), seed);
writeFileSync(new URL("../supabase/seed-sample-reviews.sql", import.meta.url), sampleReviews);
console.log(`Wrote supabase/seed.sql (${products.length} coffees, ${discountCodes.length} codes) and supabase/seed-sample-reviews.sql (${reviews.length} reviews)`);
