# Leave everything empty to run in demo mode: no database, no payments, nothing to set up.

# The public address of the site, for Stripe redirects and email links.
# Optional on Vercel (it's detected); locally it defaults to http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# Supabase: Project settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose this in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe, in test mode: Developers → API keys (sk_test_…)
STRIPE_SECRET_KEY=
# From `stripe listen` locally, or the webhook endpoint in the Stripe dashboard (whsec_…)
STRIPE_WEBHOOK_SECRET=
