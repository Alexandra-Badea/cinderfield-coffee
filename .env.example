# Leave everything empty to run without a database or payments: nothing to set up.
# On Vercel, the Supabase and Stripe integrations fill most of these in for you.

# The public address of the site, for Stripe redirects and email links.
# Optional on Vercel (it's detected); locally it defaults to http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# The shop's contact address, shown on the help pages
SHOP_EMAIL=

# Supabase: Project settings → API. The newer publishable/secret keys work too
# (NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY and SUPABASE_SECRET_KEY).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose this in the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Lets `npm run db:migrate` (and every build) set up the database: Project settings → Database → Connection string
POSTGRES_URL=
# Demo stores only: also load the sample reviews into an empty database
SEED_SAMPLE_REVIEWS=

# Stripe: Developers → API keys. sk_test_… keeps the demo-store notice on; sk_live_… takes real payments.
STRIPE_SECRET_KEY=
# From `stripe listen` locally, or the webhook endpoint in the Stripe dashboard (whsec_…)
STRIPE_WEBHOOK_SECRET=

# Resend (resend.com): the shop's own emails, the newsletter welcome and the order confirmation.
# Leave empty and the shop works the same, it just doesn't send them.
RESEND_API_KEY=
# A sender on a domain you've verified in Resend, e.g. Cinderfield <hello@your-shop.com>
EMAIL_FROM=
# Signs the one-click unsubscribe links. Any long random string; defaults to the Supabase secret key.
NEWSLETTER_SECRET=
